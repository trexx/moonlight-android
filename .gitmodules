[submodule "app/src/main/jni/moonlight-core/moonlight-common-c"]
	path = app/src/main/jni/moonlight-core/moonlight-common-c
	url = https://github.com/moonlight-stream/moonlight-common-c.git
	# scripts/apply-native-patches.py patches this submodule's working tree on every build, so
	# it is permanently "modified content". Suppress that here, not because it is dangerous -
	# staging a submodule path records its HEAD commit, which the script never moves - but
	# because permanent noise hides a real pointer bump. Working-tree changes only: a changed
	# submodule commit is still reported. Deliberately not set on libusb or mbedtls, which
	# carry no patches, so dirt there stays visible.
	ignore = dirty
[submodule "app/src/main/jni/libusb"]
	path = app/src/main/jni/libusb
	url = https://github.com/libusb/libusb.git
[submodule "app/src/main/jni/moonlight-core/mbedtls"]
	path = app/src/main/jni/moonlight-core/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
