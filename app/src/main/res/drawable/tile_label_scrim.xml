<?xml version="1.0" encoding="utf-8"?>
<!--
  Gradient behind the name at the foot of a box art tile.

  Box art is arbitrary artwork, so a name drawn straight onto it is legible against some games
  and invisible against others. A gradient rather than a flat band because a hard edge across
  the artwork reads as a rendering fault, and because the top of the label area frequently has
  nothing in it worth hiding.

  Bottom-up: transparent at the top, @color/scrim at the foot. angle=90 is bottom-to-top in
  Android's gradient convention, so startColor is the foot.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:bottomLeftRadius="@dimen/tile_corner_radius"
        android:bottomRightRadius="@dimen/tile_corner_radius" />
    <gradient
        android:angle="90"
        android:startColor="@color/scrim"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>
