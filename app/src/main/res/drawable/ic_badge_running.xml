<?xml version="1.0" encoding="utf-8"?>
<!--
  The badge on the app that is currently running on the host.

  Replaces ic_play, which was a solid white disc. Box art is arbitrary artwork and a good deal of
  it is pale, so a white badge on a white capsule was invisible - which is the worst case for this
  particular badge, since it is the only thing distinguishing "this is running" from "this will
  start" and the two have different consequences.

  Three layers, drawn outward in:

    rim     @color/surface, scaled past the disc. Separates the badge from whatever is behind it,
            which is the part a single-colour badge cannot do on unknown artwork.
    disc    @color/accent. Lime means live here, matching what colors.xml reserves it for.
    glyph   @color/surface again, knocked out of the disc rather than drawn in white, so the
            triangle stays legible against the accent.

  Colour references in fillColor need API 24; minSdk is 30.

  The rim is scaled from the same circle path as the disc rather than written out at a second
  radius, so the two cannot drift apart. 1.12 keeps it inside the 24-unit viewport: 12 +/- 11.2.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="1.12"
        android:scaleY="1.12">
        <path
            android:fillColor="@color/surface"
            android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10s10,-4.48 10,-10S17.52,2 12,2z" />
    </group>

    <path
        android:fillColor="@color/accent"
        android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10s10,-4.48 10,-10S17.52,2 12,2z" />

    <path
        android:fillColor="@color/surface"
        android:pathData="M9.5,16.5v-9l7,4.5L9.5,16.5z" />

</vector>
