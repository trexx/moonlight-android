<?xml version="1.0" encoding="utf-8"?>
<!--
  The root of the settings tree: navigation rows only, no settings of their own.

  Each row is a plain <Preference>, not a nested <PreferenceScreen>. A nested PreferenceScreen
  presents its children in a Dialog built straight from the theme, which never receives the
  overscan padding activity_stream_settings.xml applies, so it is wrong on a television.
  Preference.onClick() is empty by contrast, which leaves the row inert and lets
  StreamSettings.SettingsFragment.onPreferenceTreeClick() swap in the sub-screen fragment itself.

  The screen_ prefix is what that handler matches on; SettingsScreen maps each key to the
  preferences_*.xml below it.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="screen_video"
        android:title="@string/screen_video"
        android:summary="@string/screen_video_summary" />
    <Preference
        android:key="screen_audio"
        android:title="@string/screen_audio"
        android:summary="@string/screen_audio_summary" />
    <Preference
        android:key="screen_controllers"
        android:title="@string/screen_controllers"
        android:summary="@string/screen_controllers_summary" />
    <Preference
        android:key="screen_mouse_keyboard"
        android:title="@string/screen_mouse_keyboard"
        android:summary="@string/screen_mouse_keyboard_summary" />
    <Preference
        android:key="screen_host"
        android:title="@string/screen_host"
        android:summary="@string/screen_host_summary" />
    <Preference
        android:key="screen_advanced"
        android:title="@string/screen_advanced"
        android:summary="@string/screen_advanced_summary" />

</PreferenceScreen>
