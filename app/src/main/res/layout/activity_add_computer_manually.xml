<?xml version="1.0" encoding="utf-8"?>
<!--
  Add a host by address.

  A centred column rather than the previous title-plus-row arrangement: this screen is one field
  and one button, and on a television a form pinned to the top left of a 55" panel is a long way
  from where the eye is. Centring also removes the reason the field and button had to share a row.

  The field keeps <requestFocus/> so a keyboard-driven entry starts in the right place, and the
  activity keeps windowSoftInputMode="stateVisible" in the manifest so the soft keyboard is up on
  arrival.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_vertical"
    android:paddingBottom="@dimen/screen_padding_vertical"
    tools:context=".preferences.AddComputerManually" >

    <TextView
        android:id="@+id/manuallyAddPcText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_5"
        android:text="@string/title_add_pc"
        android:gravity="center"
        android:preferKeepClear="true"
        android:textAppearance="@style/TextAppearance.Moonlight.Title" />

    <EditText
        android:id="@+id/hostTextView"
        android:importantForAutofill="no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="480dp"
        android:singleLine="true"
        android:preferKeepClear="true"
        android:inputType="textNoSuggestions"
        android:hint="@string/ip_hint" >

        <requestFocus />
    </EditText>

    <Button
        android:id="@+id/addPcButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:paddingStart="@dimen/space_5"
        android:paddingEnd="@dimen/space_5"
        android:preferKeepClear="true"
        android:text="@android:string/ok"/>

</LinearLayout>
