<?xml version="1.0" encoding="utf-8"?>
<!--
  Container for the settings fragment, which StreamSettings commits into stream_settings by id.

  The list itself is built by the framework PreferenceFragment from one of the res/xml/preferences*
  files. What this adds is the screen's edge padding, including the television overscan inset,
  which the fragment has no way to apply for itself, and the heading above it.

  The heading is here rather than in an action bar because AppTheme sets windowNoTitle: without it
  a sub-screen would give no indication of which one you are on. StreamSettings sets its text as it
  navigates. The ground colour comes from the theme's windowBackground; painting it here as well
  would be overdraw over the whole screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_vertical"
    android:paddingBottom="@dimen/screen_padding_vertical"
    tools:context=".preferences.StreamSettings">

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_3"
        android:textAppearance="@style/TextAppearance.Moonlight.Title"
        tools:text="@string/title_settings" />

    <FrameLayout
        android:id="@+id/stream_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
