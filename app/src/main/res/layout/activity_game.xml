<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.limelight.ui.StreamView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true"
        android:defaultFocusHighlightEnabled="false">
        <requestFocus />
    </com.limelight.ui.StreamView>

    <!--
      Translucent, and deliberately so. These were briefly opaque black on the theory that a
      translucent layer above the SurfaceView forces the composer to blend, costing the video its
      own hardware plane. Measured on the Shield, that theory is wrong twice over, so do not retry
      it - HARDWARE_TESTING.md section 14 carries the dumps.

      A child View's background alpha never reaches the compositor. Layer opacity comes from the
      window's pixel format, and Game's window has to stay translucent for the SurfaceView to show
      through it, so this layer is PREMULTIPLIED and isOpaque=false whatever colour goes here.

      And there is no hardware plane to lose: the Tegra composer puts every layer through a scratch
      buffer regardless - launcher, our stream, and YouTube and Kodi playing 4K alike - leaving
      three of its four display windows unused in all of them.
    -->
    <TextView
        android:id="@+id/performanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="start"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:gravity="start"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="end"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="end"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

</merge>
