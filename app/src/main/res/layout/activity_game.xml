<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.limelight.ui.StreamView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true"
        android:defaultFocusHighlightEnabled="false">
        <requestFocus />
    </com.limelight.ui.StreamView>

    <!--
      Translucent, and deliberately so. These were briefly opaque black on the theory that a
      translucent layer above the SurfaceView forces the composer to blend, costing the video its
      own hardware plane. Measured on the Shield, that theory is wrong twice over, so do not retry
      it - HARDWARE_TESTING.md section 14 carries the dumps.

      A child View's background alpha never reaches the compositor. Layer opacity comes from the
      window's pixel format, and Game's window has to stay translucent for the SurfaceView to show
      through it, so this layer is PREMULTIPLIED and isOpaque=false whatever colour goes here.

      And there is no hardware plane to lose: the Tegra composer puts every layer through a scratch
      buffer regardless - launcher, our stream, and YouTube and Kodi playing 4K alike - leaving
      three of its four display windows unused in all of them.
    -->
    <!--
      Text and plots share one container, one background and one visibility. They are siblings
      inside this window rather than a second window, so together they are still the single extra
      composited layer section 14 measured - a child View is not a layer. Confirm with the same
      dumpsys check if that ever seems doubtful; do not assume it.
    -->
    <LinearLayout
        android:id="@+id/performanceOverlayContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/performanceOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="start" />

        <!--
          Width is fixed rather than wrap_content: a plot has no intrinsic width, and the history
          has to occupy a stable span or the line would rescale horizontally as the overlay's text
          rows change length. 260dp is a starting point to be checked on a real TV - see
          HARDWARE_TESTING.md on 10-foot legibility.
        -->
        <com.limelight.ui.SparklineView
            android:id="@+id/performanceSparklines"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="end"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="end"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <!--
      Local echo of the word the soft keyboard is still composing, sat just above the keyboard
      itself. The keyboard covers the bottom of the picture, which is where a game's chat box
      lives, so without this you cannot see what you are entering. Only pending text: anything
      committed has already gone to the host as keystrokes.

      A TextView rather than anything interactive, deliberately: it is never focused and never
      navigated. The soft keyboard owns the d-pad completely while it is up - StreamView stands
      aside for it - so anything here that needed focus could not be reached at all.

      Translucent, like the overlays above: measured on the Shield, a layer over the SurfaceView
      costs nothing, because the Tegra composer routes every layer through a scratch buffer
      regardless. See the comment above performanceOverlay.

      Single line with the ellipsis at the start, so the tail stays visible - that is where the
      cursor is.
    -->
    <TextView
        android:id="@+id/imePreviewOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:ellipsize="start"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:background="#B0000000"
        android:focusable="false"
        android:preferKeepClear="true"
        android:visibility="gone" />

</merge>
